# ============================================================
# AI Intelligence Ingestion Platform - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.

# --- LLM Providers ---
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# --- GitHub ---
GITHUB_TOKEN=your_github_personal_access_token_here

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_intelligence

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Google Sheets ---
# Path to your service account JSON credentials file
GOOGLE_SHEETS_CREDENTIALS=credentials/google_sheets_credentials.json
# Leave blank to auto-create a new spreadsheet
GOOGLE_SPREADSHEET_ID=

# --- Logging ---
LOG_LEVEL=INFO

# --- Concurrency ---
MAX_CONCURRENT_REQUESTS=20
BATCH_SIZE=50
CHUNK_TOKEN_LIMIT=4000

# --- LLM Model Config ---
PRIMARY_LLM_PROVIDER=gemini
PRIMARY_LLM_MODEL=gemini-1.5-flash
SECONDARY_LLM_PROVIDER=groq
SECONDARY_LLM_MODEL=llama3-70b-8192
TERTIARY_LLM_PROVIDER=deepseek
TERTIARY_LLM_MODEL=deepseek-chat

# --- Pipeline Targets ---
TARGET_STARTUPS=1000
TARGET_PRODUCTS=1000
TARGET_PAPERS=1000
FRESHNESS_HOURS=24

# --- arXiv ---
ARXIV_MAX_RESULTS=1500
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL,cs.CV,cs.RO,stat.ML

# --- Rate Limits (requests per minute) ---
ARXIV_RATE_LIMIT=30
GITHUB_RATE_LIMIT=30
PRODUCTHUNT_RATE_LIMIT=10
HF_RATE_LIMIT=20
NEWS_RATE_LIMIT=15
JOB_RATE_LIMIT=15

# --- Retry Config ---
MAX_RETRIES=5
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=60.0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- ChromaDB ---
CHROMA_PERSIST_DIR=data/chroma
